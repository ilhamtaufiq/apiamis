# Contoh env untuk image Rust-only (apiamis-api). Salin ke Coolify sebagai environment variable,
# jangan commit file .env yang berisi nilai asli.
#
# Nilai dalam <...> wajib diganti. Variabel lain punya nilai bawaan di kode.

# ---- Aplikasi ----
# Harus sama dengan APP_NAME di Laravel. Nilai ini ikut membentuk prefix cache OAuth dan
# kunci cache. Bila berbeda, cache lama tidak terbaca.
APP_NAME=<nama-aplikasi-seperti-di-laravel>
APP_ENV=production
APP_URL=https://apiamis.cianjur.space
# Port binary Rust (Apache meneruskan /api, /up, dan / ke sini).
APP_PORT=8000
FRONTEND_URL=https://arumanis.cianjur.space
PENGAWAS_APP_BASE_URL=https://pengawasan.arumanis.cianjur.space

# ---- Database (wajib) ----
# Format: mysql://user:password@host:3306/nama_db
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>
# Ukuran pool koneksi (bawaan 5) dan waktu idle sebelum koneksi ditutup, dalam detik (bawaan 60).
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT_SECS=60
# Kunci enkripsi Laravel (APP_KEY). Dipakai untuk membuka secret yang tersimpan terenkripsi
# (mis. kredensial SPSE dan backup Google Drive). Harus sama dengan milik Laravel.
APP_KEY=base64:<kunci-dari-laravel>

# ---- Autentikasi ----
# Umur token dalam menit (bawaan 720 = 12 jam, sama dengan Sanctum). 0 berarti tidak kedaluwarsa.
SANCTUM_TOKEN_EXPIRATION=720
SESSION_COOKIE_NAME=<nama-cookie-sesi>
SESSION_COOKIE_SECURE=true
ARUMANIS_AUTH_COOKIE=arumanis_token
ARUMANIS_IMPERSONATOR_COOKIE=arumanis_impersonator
# Email yang tetap bisa masuk saat mode maintenance (dipisah koma).
MAINTENANCE_BYPASS_EMAILS=

# ---- Google login (opsional, hanya bila dipakai) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://apiamis.cianjur.space/api/auth/google/callback
MOBILE_OAUTH_CALLBACK_URL=

# ---- Penyimpanan berkas ----
# Bawaan di kode mengacu ke folder sumber saat build. Di image, arahkan ke volume.
PUBLIC_STORAGE_PATH=/var/www/html/storage/app/public
PRIVATE_STORAGE_PATH=/var/www/html/storage/app/private
SPAM_IMPORT_DIR=/var/www/html/storage/app/temp
KONTRAK_TEMPLATE_DIR=/var/www/html/storage/app/templates
VILLAGE_GEOJSON_PATH=/var/www/html/resources/geojson/id3203_cianjur_simplified.geojson
ONLYOFFICE_TEMP_DIR=

# ---- ONLYOFFICE (dokumen dan PDF) ----
ONLYOFFICE_DOCUMENT_SERVER_URL=<url-document-server>
ONLYOFFICE_JWT_SECRET=<secret-jwt>
ONLYOFFICE_CALLBACK_URL=
ONLYOFFICE_DOWNLOAD_TOKEN_TTL=

# ---- SPSE (kontrak dan procurement) ----
SPSE_BASE_URL=https://spse.inaproc.id
SPSE_LPSE_SLUG=cianjurkab
SPSE_PPK_NAMA=<nama-ppk>
SPSE_PPK_NIP=<nip-ppk>
SPSE_PPK_JABATAN=<jabatan-ppk>
SPSE_PPK_NO_SK=<nomor-sk-ppk>
SPSE_SATKER_KOTA=Cianjur
SPSE_SATKER_ALAMAT=
SPSE_CARA_PEMBAYARAN=Sekaligus

# ---- Cache ----
# Prefix kunci cache. Kosongkan bila tidak perlu.
CACHE_PREFIX=

# ---- Batas permintaan ----
RUST_BODY_LIMIT_BYTES=10485760
RUST_REQUEST_TIMEOUT_SECS=30

# ---- Tidak dipakai binary Rust ----
# Variabel Laravel (MAIL_*, REVERB_*, QUEUE_*, SESSION_DRIVER, dan lainnya) tidak perlu di-set.
# Konfigurasi email dibaca dari pengaturan aplikasi di database.

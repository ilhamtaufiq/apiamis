# ============ Dependencies (jangan kirim ke daemon) ============
/vendor
/node_modules
**/node_modules
/venv
/.venv
__pycache__/
*.py[cod]
/scripts/venv

# ============ Build outputs (dibangun ulang di dalam image) ============
/public/build
/public/hot
/public/storage

# ============ Uploads & runtime data (BESAR: storage/app lokal 2.2GB) ============
# storage/app/public = upload user (PDF/foto/video), storage/app/private = backup.
# Keduanya data runtime (volume Coolify), BUKAN bagian image.
# storage/app/templates WAJIB ikut image (dipakai KontrakTemplateService).
/storage/app/private/**
/storage/app/public/**
/storage/app/temp-video/**
/storage/ai/vector_db/**
/storage/logs/**
/storage/framework/cache/**
/storage/framework/sessions/**
/storage/framework/views/**
/storage/*.key
/storage/pail

# ============ Berkas besar sekali pakai (tidak dipakai aplikasi) ============
/RKA Parsial.pdf
/Template_Kontrak.docx
/docs
*.log
*.cache
# File kunci sementara Microsoft Office
~$*

# ============ Test & scaffolding lokal ============

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
L5_SWAGGER_CONST_HOST="${APP_URL}/api"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# reverb = WebSocket otomatis di-start oleh docker-entrypoint.sh (satu container dengan Apache)
# Jika REVERB_APP_KEY diset, entrypoint otomatis mengubah BROADCAST_CONNECTION ke reverb.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=arumanis
REVERB_APP_KEY=arumanis-reverb-key
REVERB_APP_SECRET=arumanis-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# PHP broadcast() → Reverb internal (default loopback, same container)
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
# OAuth callback untuk backup → Google Drive (aktifkan Google Drive API di Cloud Console)
GOOGLE_DRIVE_REDIRECT_URI="${APP_URL}/api/app-settings/backups/google-drive/callback"

FRONTEND_URL="http://arumanis.test"
# Deep link OAuth untuk app mobile pengawasan (?platform=mobile)
MOBILE_OAUTH_CALLBACK_URL="pengawas://oauth-callback"
# URL panel pengawas (path relatif atau URL penuh). Contoh produksi: https://arumanis.cianjur.space/pengawasan
PENGAWAS_APP_BASE_URL="/pengawasan"

# ONLYOFFICE Document Server (self-host minimal: docker/onlyoffice/docker-compose.yml)
# Lokal:  docker compose -f docker/onlyoffice/docker-compose.yml up -d
# Coolify: docker/onlyoffice/docker-compose.coolify.yml + domain office.*
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8088
# Harus SAMA dengan OO_JWT_SECRET di docker/onlyoffice/.env
ONLYOFFICE_JWT_SECRET=change_me_onlyoffice_jwt_secret
ONLYOFFICE_DOWNLOAD_TOKEN_TTL=120
# APP_URL harus bisa diakses container ONLYOFFICE (unduh file + callback save)
# Dev Laragon: APP_URL=http://host.docker.internal:8000

OPENROUTER_API_KEY=

# WhatsApp bridge (Baileys) — otomatis jalan di container APIAMIS (sama pola dengan Reverb)
WHATSAPP_BRIDGE_URL=http://127.0.0.1:4000
WHATSAPP_BRIDGE_KEY=
# DISABLE_WHATSAPP_BRIDGE=true
# WHATSAPP_AUTH_DIR=/var/www/html/storage/app/whatsapp-auth

